{
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test integration/*.test.ts",
    "test:browser": "tsx integration/browser.e2e.ts",
    "test:browser:focused": "tsx integration/focused.browser.ts",
    "seed": "tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@supabase/supabase-js": "^2.98.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.8",
    "prisma": "^6.19.2",
    "socket.io": "^4.8.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "name": "chaloauto-backend",
  "private": true,
  "engines": {
    "node": ">=20.11"
  }
}
