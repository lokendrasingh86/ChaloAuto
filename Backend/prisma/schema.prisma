generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String?
  phone     String   @unique
  role      UserRole @default(Passenger)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driver    Driver?
  rides     Ride[]
}

model Driver {
  id                 String   @id @default(uuid())
  userId             String   @unique
  licenseNumber      String
  routeId            String?
  currentLocationLat Float
  currentLocationLng Float
  isAvailable        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  route              Route?   @relation(fields: [routeId], references: [id])
  user               User     @relation(fields: [userId], references: [id])
  rides              Ride[]   @relation("DriverRides")
  vehicle            Vehicle?
}

model Vehicle {
  id           String   @id @default(uuid())
  driverId     String   @unique
  make         String
  model        String
  year         Int
  licensePlate String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  driver       Driver   @relation(fields: [driverId], references: [id])
}

model Route {
  id       String       @id @default(uuid())
  name     String
  startLat Float
  startLng Float
  endLat   Float
  endLng   Float
  drivers  Driver[]
  rides    Ride[]
  points   RoutePoint[]
}

model Ride {
  id          String     @id @default(uuid())
  passengerId String
  routeId     String?
  driverId    String?
  pickupLat   Float
  pickupLng   Float
  status      RideStatus @default(Requested)
  createdAt   DateTime   @default(now())
  driver      Driver?    @relation("DriverRides", fields: [driverId], references: [id])
  passenger   User       @relation(fields: [passengerId], references: [id])
  route       Route?     @relation(fields: [routeId], references: [id])

  @@index([routeId])
  @@index([driverId])
}

model RoutePoint {
  id       String @id @default(uuid())
  routeId  String
  lat      Float
  lng      Float
  sequence Int
  route    Route  @relation(fields: [routeId], references: [id])
}

enum UserRole {
  Passenger
  Driver
}

enum RideStatus {
  Requested
  Accepted
  Completed
  Cancelled
}
