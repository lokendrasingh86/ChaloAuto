generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String?
  phone     String   @unique
  role      UserRole @default(Passenger)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driver    Driver?
  rides     Ride[]
  choiceOffers ChoiceOffer[]
}

model Driver {
  id                 String   @id @default(uuid())
  userId             String   @unique
  licenseNumber      String
  routeId            String?
  currentLocationLat Float
  currentLocationLng Float
  isAvailable        Boolean  @default(true)
  capacity           Int      @default(4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  route              Route?   @relation(fields: [routeId], references: [id])
  user               User     @relation(fields: [userId], references: [id])
  rides              Ride[]   @relation("DriverRides")
  vehicle            Vehicle?
  lastLocationAt     DateTime?
  locationVersion    Int       @default(0)
  routeVersion       Int       @default(0)
  remainingStops     Json      @default("[]")
  choiceOffers       ChoiceOffer[]
}

model Vehicle {
  id           String   @id @default(uuid())
  driverId     String   @unique
  make         String
  model        String
  year         Int
  licensePlate String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  driver       Driver   @relation(fields: [driverId], references: [id])
}

model Route {
  id       String       @id @default(uuid())
  name     String
  startLat Float
  startLng Float
  endLat   Float
  endLng   Float
  drivers  Driver[]
  rides    Ride[]
  points   RoutePoint[]
  roadGeometry Json?
  roadGeometryAt DateTime?
}

model Ride {
  id          String     @id @default(uuid())
  passengerId String
  routeId     String?
  driverId    String?
  pickupLat   Float
  pickupLng   Float
  dropLat     Float?
  dropLng     Float?
  status      RideStatus @default(Requested)
  poolId         String?
  pickupSequence Int?
  dropSequence   Int?
  distanceKm     Float?
  fare           Float?
  rating         Int?
  ratingComment  String?
  matchedAt      DateTime?
  acceptedAt     DateTime?
  completedAt    DateTime?
  createdAt   DateTime   @default(now())
  driver      Driver?    @relation("DriverRides", fields: [driverId], references: [id])
  passenger   User       @relation(fields: [passengerId], references: [id])
  route       Route?     @relation(fields: [routeId], references: [id])
  plannerMode PlannerMode @default(Legacy)
  pickedUpAt DateTime?
  lockedFare Float?
  quoteShared Boolean @default(false)
  addedDelaySeconds Int @default(0)
  rawPickupLat Float?
  rawPickupLng Float?
  rawDropLat Float?
  rawDropLng Float?
  choiceOffer ChoiceOffer?

  @@index([routeId])
  @@index([driverId])
  @@index([poolId])
  @@index([status])
}

model ChoiceOffer {
  id String @id @default(uuid())
  passengerId String
  driverId String
  routeId String
  routeVersion Int
  locationVersion Int
  trip Json
  proposal Json?
  quoteFare Float
  quoteDistanceKm Float
  quoteShared Boolean
  status ChoiceOfferStatus @default(Quoted)
  expiresAt DateTime
  createdAt DateTime @default(now())
  rideId String? @unique
  passenger User @relation(fields: [passengerId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])
  ride Ride? @relation(fields: [rideId], references: [id], onDelete: SetNull)
  @@index([driverId, status, expiresAt])
  @@index([passengerId, status, expiresAt])
}

enum PlannerMode {
  Legacy
  Choice
}

enum ChoiceOfferStatus {
  Quoted
  Pending
  Accepted
  Declined
  Expired
  Cancelled
  Invalidated
}

model RoutePoint {
  id       String @id @default(uuid())
  routeId  String
  lat      Float
  lng      Float
  sequence Int
  route    Route  @relation(fields: [routeId], references: [id])
}

enum UserRole {
  Passenger
  Driver
}

enum RideStatus {
  Requested
  Accepted
  PickedUp
  Completed
  Cancelled
}
