# Server
PORT=8000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API (leave empty for any in dev)
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL, e.g. Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/chaloauto

# Supabase auth (phone OTP)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Development test login (numbers containing 99990000 / 88880000, OTP 123456).
# Always set ALLOW_TEST_LOGIN=false and a strong JWT_SECRET in production.
ALLOW_TEST_LOGIN=true
JWT_SECRET=change-me

# Comma-separated user ids allowed to create/edit/delete routes
ADMIN_USER_IDS=

# Matching (System-Aware algorithm)
MATCHING_PROFILE=Balanced          # Passenger-Focused | Balanced | System-Focused
MATCHING_INTERVAL_SECONDS=5
MAX_DETOUR_RATIO=0.5
MAX_WAIT_MINUTES=10
DRIVER_RESPONSE_SECONDS=60

# Passenger-choice demo (separate from the legacy batch matcher's 60-second offer)
CHOICE_ROUTE_NAME=Connaught Place to IGI Airport
# Light educational use only: cached generic road estimates, no live traffic.
# Use a hosted/self-managed compatible OSRM service for larger workloads.
OSRM_BASE_URL=https://router.project-osrm.org
